{
  "name": "@thermal-label/niimbot-core",
  "version": "0.0.0",
  "description": "Device registry, media catalog and printer adapter for NIIMBOT label printers, built on niimbluelib",
  "keywords": [
    "niimbot",
    "niimbluelib",
    "d11",
    "d110",
    "b1",
    "b21",
    "label-printer",
    "thermal-label",
    "thermal-printer"
  ],
  "type": "module",
  "author": "MBTech",
  "license": "MIT",
  "homepage": "https://thermal-label.github.io/niimbot/core",
  "repository": {
    "type": "git",
    "url": "https://github.com/thermal-label/niimbot.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/thermal-label/niimbot/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/mannes"
    },
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/mannes"
    }
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "data/devices.json",
    "data/media.json",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "compile-data": "node scripts/compile-data.mjs",
    "prebuild": "pnpm run compile-data",
    "pretypecheck": "pnpm run compile-data",
    "pretest": "pnpm run compile-data",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mbtech-nl/bitmap": "^1.3.0",
    "@mmote/niimbluelib": "0.49.1",
    "@thermal-label/contracts": "^0.6.3"
  },
  "devDependencies": {
    "@mbtech-nl/tsconfig": "^1.1.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "json5": "^2.2.3",
    "typescript": "~5.5.0",
    "vitest": "^2.0.0"
  }
}
